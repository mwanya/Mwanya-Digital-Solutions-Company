APP_NAME="Heisen Group Company Limited"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Africa/Dar_es_Salaam"
APP_URL=http://localhost/heisen-group-website/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# WAMP default MySQL settings. Update if your WAMP install uses a password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heisen_group_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="heisengroup.tz@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Quick Help AI chat (optional). Get a key at https://console.anthropic.com
# Leave blank to use the built-in Quick Answers fallback instead (still works
# great with zero configuration — see README "Quick Help Chat" section).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Company contact details used across the site
COMPANY_PHONE_PRIMARY="+255 650 552 696"
COMPANY_PHONE_SECONDARY=""
COMPANY_EMAIL="heisengroup.tz@gmail.com"
COMPANY_ADDRESS="Bibi Titi Road, Nyerere Tower, 2nd Floor, near DIT College, Dar es Salaam, Tanzania"
COMPANY_FACEBOOK="Heisen_group"
COMPANY_INSTAGRAM="Heisen_group"
